# WEXYRON Server Configuration
# Copy this file to .env and customize the values

# Server Settings
SERVER_NAME=WEXYRON Server
SERVER_PORT=7777
MAX_PLAYERS=16

# Players allowed from one machine (same PC/IP + machine id):
#   -1 = unlimited, 0 = nobody, N = up to N instances per PC.
# Leave empty/unset to use server.maxPlayersPerMachine from server_config.json.
# MAX_PLAYERS_PER_MACHINE=2
SERVER_REGION=US-East
SERVER_DESCRIPTION=Custom game server

# Gameplay Settings
DEFAULT_MAP=simple.map
ALLOW_MAP_CHANGE=true
FRIENDLY_FIRE=false
RESPAWN_TIME=5.0
ROUND_TIME=115.0

# Server-side bots
# count: 0 disables bots; accuracy: 0..1 hit chance
BOTS_COUNT=4
BOTS_ACCURACY=0.7

# Network Settings
TICK_RATE=60
TIMEOUT=30.0
MAX_PING=500

# Logging
LOG_LEVEL=info
