# Windows Makefile for OpenGL Game (MinGW / MSYS2)
# Usage (inside MSYS2 UCRT64 or MINGW64, PATH must contain the toolchain):
#   mingw32-make -f Makefile.windows
# Canonical with CMakeLists.txt: same sources, same C++17 flags, same
# OpenGL 3.3-core requirement. Linux uses ./Makefile; this file is
# Windows-only, so changes here cannot break the Linux build.

CXX = g++
CXXFLAGS = -std=c++17 -Wall -I./include -I./include/stb -I./src
# Track header dependencies so editing a header (e.g. game.hpp) recompiles every
# object that uses it. Stale objects would otherwise disagree about sizeof(Game)
# and corrupt game members at wrong offsets.
DEPFLAGS = -MMD -MP
# Client needs GLFW + system OpenGL; the headless server must NOT, so a
# server without a GPU/GLFW runtime still starts.
CLIENT_LDFLAGS = -lglfw3 -lopengl32 -lgdi32 -luser32 -lkernel32 -lshell32 -lws2_32 -lstdc++ -lpthread
SERVER_LDFLAGS = -lws2_32 -lstdc++ -lpthread

SRC_DIR = src
CORE_DIR = src/core
SYSTEMS_DIR = src/systems
ENGINE_DIR = src/engine
GAME_DIR = src/game
NETWORK_DIR = src/network
UI_DIR = src/ui
BUILD_DIR = build/obj
BIN_DIR = build/bin
TARGET = $(BIN_DIR)/game.exe
SERVER_TARGET = $(BIN_DIR)/server.exe

# Source files
CORE_SOURCES = $(CORE_DIR)/game.cpp $(CORE_DIR)/game_input.cpp $(CORE_DIR)/game_loop.cpp $(CORE_DIR)/game_gameplay.cpp $(CORE_DIR)/game_hud.cpp $(CORE_DIR)/game_menus.cpp $(CORE_DIR)/game_server.cpp $(CORE_DIR)/game_server_menu.cpp $(CORE_DIR)/game_audio.cpp $(CORE_DIR)/game_editor.cpp $(CORE_DIR)/settings.cpp $(CORE_DIR)/renderer.cpp $(CORE_DIR)/camera.cpp $(CORE_DIR)/map.cpp $(CORE_DIR)/map_loader.cpp $(CORE_DIR)/shader.cpp $(CORE_DIR)/texture.cpp
SYSTEMS_SOURCES = $(SYSTEMS_DIR)/input.cpp $(SYSTEMS_DIR)/weapon.cpp $(SYSTEMS_DIR)/physics.cpp $(SYSTEMS_DIR)/enemy.cpp $(SYSTEMS_DIR)/projectile.cpp $(SYSTEMS_DIR)/player.cpp $(SYSTEMS_DIR)/game_state.cpp
NETWORK_SOURCES = $(NETWORK_DIR)/network.cpp $(NETWORK_DIR)/server_config.cpp
GAME_BOT_SOURCES = $(GAME_DIR)/bot.cpp
SERVER_BOT_SOURCES = $(NETWORK_DIR)/server_bots.cpp $(NETWORK_DIR)/server_bomb.cpp
UI_SOURCES = $(UI_DIR)/menu_core.cpp $(UI_DIR)/menu_draw.cpp $(UI_DIR)/menu_input.cpp $(UI_DIR)/menu_pages.cpp
ENGINE_SOURCES = $(ENGINE_DIR)/audio_manager.cpp
MINIAUDIO_SOURCES = third_party/miniaudio/miniaudio.c
MAIN_SOURCES = $(SRC_DIR)/main.cpp
SERVER_SOURCES = server_main.cpp $(NETWORK_SOURCES) $(GAME_BOT_SOURCES) $(SERVER_BOT_SOURCES)
GLAD_SOURCES = glad.c
ALL_SOURCES = $(CORE_SOURCES) $(SYSTEMS_SOURCES) $(NETWORK_SOURCES) $(GAME_BOT_SOURCES) $(UI_SOURCES) $(ENGINE_SOURCES) $(MINIAUDIO_SOURCES) $(MAIN_SOURCES) $(GLAD_SOURCES)

# Object files
CORE_OBJECTS = $(addprefix $(BUILD_DIR)/core/, $(notdir $(CORE_SOURCES:.cpp=.o)))
SYSTEMS_OBJECTS = $(addprefix $(BUILD_DIR)/systems/, $(notdir $(SYSTEMS_SOURCES:.cpp=.o)))
NETWORK_OBJECTS = $(addprefix $(BUILD_DIR)/network/, $(notdir $(NETWORK_SOURCES:.cpp=.o)))
GAME_BOT_OBJECTS = $(addprefix $(BUILD_DIR)/game/, $(notdir $(GAME_BOT_SOURCES:.cpp=.o)))
SERVER_BOT_OBJECTS = $(addprefix $(BUILD_DIR)/network/, $(notdir $(SERVER_BOT_SOURCES:.cpp=.o)))
UI_OBJECTS = $(addprefix $(BUILD_DIR)/ui/, $(notdir $(UI_SOURCES:.cpp=.o)))
ENGINE_OBJECTS = $(addprefix $(BUILD_DIR)/engine/, $(notdir $(ENGINE_SOURCES:.cpp=.o)))
MAIN_OBJECT = $(BUILD_DIR)/main.o
SERVER_MAIN_OBJECT = $(BUILD_DIR)/server_main.o
GLAD_OBJECT = $(BUILD_DIR)/glad.o
MINIAUDIO_OBJECT = $(BUILD_DIR)/third_party/miniaudio.o
ALL_OBJECTS = $(CORE_OBJECTS) $(SYSTEMS_OBJECTS) $(NETWORK_OBJECTS) $(GAME_BOT_OBJECTS) $(UI_OBJECTS) $(ENGINE_OBJECTS) $(MAIN_OBJECT) $(GLAD_OBJECT) $(MINIAUDIO_OBJECT)
SERVER_OBJECTS = $(SERVER_MAIN_OBJECT) $(NETWORK_OBJECTS) $(GAME_BOT_OBJECTS) $(SERVER_BOT_OBJECTS)

# Toolchain bin dir holding the MinGW runtime + glfw3.dll (UCRT64 by
# default; MINGW64 if that is what is on PATH). Resolved at recipe time so
# `mingw32-make` works from either environment without editing this file.
DLL_SEARCH_DIRS = /ucrt64/bin /mingw64/bin /c/msys64/ucrt64/bin /c/msys64/mingw64/bin

all: $(TARGET) $(SERVER_TARGET)

client: $(TARGET)

server: $(SERVER_TARGET)

$(TARGET): $(ALL_OBJECTS) | $(BIN_DIR)
	$(CXX) $^ -o $@ $(CLIENT_LDFLAGS)
	$(MAKE) -f Makefile.windows --no-print-directory stage-runtime

$(SERVER_TARGET): $(SERVER_OBJECTS) | $(BIN_DIR)
	$(CXX) $^ -o $@ $(SERVER_LDFLAGS)
	$(MAKE) -f Makefile.windows --no-print-directory stage-runtime

# Core object files
$(BUILD_DIR)/core/%.o: $(CORE_DIR)/%.cpp | $(BUILD_DIR)/core
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Systems object files
$(BUILD_DIR)/systems/%.o: $(SYSTEMS_DIR)/%.cpp | $(BUILD_DIR)/systems
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Network object files
$(BUILD_DIR)/network/%.o: $(NETWORK_DIR)/%.cpp | $(BUILD_DIR)/network
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# UI object files
$(BUILD_DIR)/ui/%.o: $(UI_DIR)/%.cpp | $(BUILD_DIR)/ui
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Engine object files
$(BUILD_DIR)/engine/%.o: $(ENGINE_DIR)/%.cpp | $(BUILD_DIR)/engine
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Game object files
$(BUILD_DIR)/game/%.o: $(GAME_DIR)/%.cpp | $(BUILD_DIR)/game
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Main object file
$(BUILD_DIR)/main_new.o: $(SRC_DIR)/main_new.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Main object file
$(BUILD_DIR)/main.o: $(SRC_DIR)/main.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Server main object file
$(BUILD_DIR)/server_main.o: server_main.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# GLAD object file
$(GLAD_OBJECT): $(GLAD_SOURCES) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# Create directories
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/core: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/core

$(BUILD_DIR)/systems: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/systems

$(BUILD_DIR)/network: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/network

$(BUILD_DIR)/ui: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/ui

$(BUILD_DIR)/engine: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/engine

$(BUILD_DIR)/game: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/game

$(BUILD_DIR)/third_party: $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/third_party

# miniaudio implementation (large, stable header: compiled once).
$(MINIAUDIO_OBJECT): $(MINIAUDIO_SOURCES) | $(BUILD_DIR)/third_party
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BIN_DIR): $(BUILD_DIR)
	mkdir -p $(BIN_DIR)

# Stage everything the exes need at runtime into build/bin so the game can
# be double-clicked (no MSYS2 on PATH) and the Mesa fallback can find its
# DLLs. Idempotent; safe to run after either target. Mirrors the CMake
# POST_BUILD steps — keep the two in sync.
#   assets/            -> build/bin/assets (exe-relative; see game.cpp)
#   libgcc/libstdc++/libwinpthread/glfw3.dll -> build/bin (toolchain or
#                          the vendored .mingw-dlls bundle as fallback)
#   mesa-deps/x64/*    -> opengl32_sw.dll + libgallium_wgl.dll +
#                          libdlclose-skip.dll (renamed opengl32 only; the
#                          system opengl32.dll stays the default)
stage-runtime:
	mkdir -p $(BIN_DIR) $(BIN_DIR)/assets
	cp -a assets/. $(BIN_DIR)/assets/
	rm -f $(BIN_DIR)/assets/settings.cfg $(BIN_DIR)/assets/machine_id 2>/dev/null || true
	@for dll in libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll glfw3.dll; do \
		found=""; \
		for d in $(DLL_SEARCH_DIRS); do \
			if [ -f "$$d/$$dll" ]; then cp -f "$$d/$$dll" $(BIN_DIR)/; found="$$d/$$dll"; break; fi; \
		done; \
		if [ -z "$$found" ] && [ -f ".mingw-dlls/$$dll" ]; then cp -f ".mingw-dlls/$$dll" $(BIN_DIR)/; found=".mingw-dlls/$$dll"; fi; \
		if [ -z "$$found" ]; then echo "stage-runtime: warning: $$dll not found in toolchain or .mingw-dlls (run pacman -S mingw-w64-ucrt-x86_64-glfw)" >&2; fi; \
	done
	@if [ -f mesa-deps/x64/opengl32.dll ]; then \
		cp -f mesa-deps/x64/libgallium_wgl.dll mesa-deps/x64/libdlclose-skip.dll $(BIN_DIR)/ 2>/dev/null || true; \
		cp -f mesa-deps/x64/opengl32.dll $(BIN_DIR)/opengl32_sw.dll; \
		echo "stage-runtime: Mesa software renderer staged as $(BIN_DIR)/opengl32_sw.dll (auto-fallback for VMs without a GPU; CUBE_RENDERER=gpu disables it)"; \
	else \
		echo "stage-runtime: warning: mesa-deps/x64/opengl32.dll missing — shipping without the GPU-less fallback" >&2; \
	fi

clean:
	rm -rf $(BUILD_DIR) $(BIN_DIR)

run: $(TARGET)
	$(TARGET)

run-server: $(SERVER_TARGET)
	$(SERVER_TARGET)

debug: CXXFLAGS += -g -DDEBUG
debug: $(TARGET)

# Header dependency files produced by -MMD (included after the first target so
# they never become the default goal).
-include $(ALL_OBJECTS:.o=.d)
-include $(SERVER_OBJECTS:.o=.d)

.PHONY: all clean run run-server debug client server stage-runtime
