# Cube Game Server Configuration
# Copy this file to .env and customize the values

# Server Settings
SERVER_NAME=Cube Game Server
SERVER_PORT=7777
MAX_PLAYERS=16
SERVER_REGION=US-East
SERVER_DESCRIPTION=Custom game server

# Gameplay Settings
DEFAULT_MAP=simple.map
ALLOW_MAP_CHANGE=true
FRIENDLY_FIRE=false
RESPAWN_TIME=5.0

# Network Settings
TICK_RATE=60
TIMEOUT=30.0
MAX_PING=500

# Logging
LOG_LEVEL=info
