// Windows resource file for launcher.exe
// Embeds: application manifest (RT_MANIFEST) + version info (VS_VERSION_INFO)
//
// The manifest is the most important part for SmartScreen mitigation:
//   - asInvoker  → no UAC prompt, lowers risk score
//   - compatibility → marks this as a Win10/11 app, suppresses shims
//
// The version info (ProductName, CompanyName, etc.) contributes to the
// SmartScreen reputation score over time and is required by some AV products.

#include <windows.h>

// --- Application manifest ---
// ID 1, type 24 (RT_MANIFEST) — the standard location Windows looks for it.
1 RT_MANIFEST "app.manifest"

// --- Version info ---
VS_VERSION_INFO VERSIONINFO
  FILEVERSION    1, 0, 0, 0
  PRODUCTVERSION 1, 0, 0, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"   // Language: English (US), Code page: Unicode
    BEGIN
      VALUE "CompanyName",      "WEXYRON\0"
      VALUE "FileDescription",  "WEXYRON Game Launcher\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "launcher\0"
      VALUE "LegalCopyright",   "Copyright (C) WEXYRON\0"
      VALUE "OriginalFilename", "launcher.exe\0"
      VALUE "ProductName",      "WEXYRON\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200   // English (US), Unicode
  END
END
